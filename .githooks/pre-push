#!/usr/bin/env bash
# main ブランチへの直接 push を止める（人が直接打った場合の守り）。
# 有効化: git config core.hooksPath .githooks

set -euo pipefail

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [[ "$remote_ref" == "refs/heads/main" ]]; then
    echo "[pre-push] main ブランチへの直接 push は止めています。作業ブランチから PR を作ってください。" >&2
    exit 1
  fi
done
exit 0
